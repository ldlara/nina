# Build multi-stage de produção. Uso: --build-arg PROJECT=Nina.Api (ou Nina.Bff)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG PROJECT
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet publish backend/src/${PROJECT}/${PROJECT}.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG PROJECT
ENV ASPNETCORE_URLS=http://+:8080 PROJECT_DLL=${PROJECT}.dll
WORKDIR /app
COPY --from=build /out .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "dotnet $PROJECT_DLL"]
