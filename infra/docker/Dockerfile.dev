# Imagem de desenvolvimento .NET (SDK) — usada por api e bff no docker compose.
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_USE_POLLING_FILE_WATCHER=1 \
    HOME=/tmp/home \
    DOTNET_CLI_HOME=/tmp/home \
    NUGET_PACKAGES=/tmp/home/.nuget/packages
# Não roda como root; o UID pode ser sobrescrito (build-arg APP_UID) para casar com o dono dos arquivos montados.
ARG APP_UID=1654
RUN mkdir -p /tmp/home && chown -R ${APP_UID} /tmp/home
USER ${APP_UID}
EXPOSE 8080
