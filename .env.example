# Copie para .env (não versionado) e gere valores ÚNICOS e fortes para cada senha, por exemplo:
#   openssl rand -base64 33 | tr -d '/+=\n'
# Sem defaults: o compose recusa subir se alguma estiver vazia. Nunca reutilize em outros ambientes.

# Dono/migrator do banco (aplica a migração). A aplicação NÃO usa este login.
POSTGRES_USER=nina_owner
POSTGRES_OWNER_PASSWORD=

# Logins de aplicação (papéis nina_app / nina_worker / nina_config_admin, sujeitos a RLS)
NINA_APP_PASSWORD=
NINA_WORKER_PASSWORD=
NINA_CONFIG_ADMIN_PASSWORD=

# Opcional (profile dbhost): porta do host para o PostgreSQL, sempre em 127.0.0.1
# POSTGRES_HOST_PORT=5432
# Segredo BFF<->API (>= 32 caracteres). Gere com: openssl rand -base64 48
INTERNAL_SHARED_SECRET=
